<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Book</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="manage-books-page">
  <h2>Add New Book</h2>

  <form action="/admin/add" method="POST" class="book-form">
    <div class="form-group">
      <label for="title">Title:</label>
      <input type="text" id="title" name="title" required placeholder="Enter book title">
    </div>

    <div class="form-group">
      <label for="author">Author:</label>
      <input type="text" id="author" name="author" required placeholder="Enter author name">
    </div>

    <div class="form-group">
      <label for="genre">Genre:</label>
      <input type="text" id="genre" name="genre" placeholder="Optional">
    </div>

    <div class="form-group">
      <label for="year">Publication Year:</label>
      <input type="number" id="year" name="year" placeholder="Optional">
    </div>

    <button type="submit" class="edit-btn">Add Book</button>
  </form>

  <a href="/admin/books" class="back-link">Back to Books</a>
</body>
</html>